{
    "name": "heidi/framework",
    "description": "An identity provider for the Symfony ecosystem: identity core, OAuth 2.0 / OpenID Connect module, Symfony bundle.",
    "type": "symfony-bundle",
    "license": "MIT",
    "homepage": "https://github.com/Spomky-Labs/heidi",
    "keywords": [
        "oauth2",
        "openid-connect",
        "identity-provider",
        "authorization-server",
        "symfony",
        "symfony-bundle"
    ],
    "authors": [
        {
            "name": "All contributors"
        }
    ],
    "require": {
        "php": ">=8.4",
        "doctrine/dbal": "^4.4",
        "doctrine/doctrine-bundle": "^3.3",
        "doctrine/migrations": "^3.9",
        "doctrine/orm": "^3.7",
        "psr/clock": "^1.0",
        "psr/event-dispatcher": "^1.0",
        "psr/log": "^3.0",
        "symfony/clock": "8.2.*",
        "symfony/config": "8.2.*",
        "symfony/dependency-injection": "8.2.*",
        "symfony/doctrine-bridge": "8.2.*",
        "symfony/framework-bundle": "8.2.*",
        "symfony/http-foundation": "8.2.*",
        "symfony/http-kernel": "8.2.*",
        "symfony/key-management": "8.2.*",
        "symfony/messenger": "8.2.*",
        "symfony/uid": "8.2.*",
        "web-token/jwt-library": "^4.2"
    },
    "require-dev": {
        "roave/security-advisories": "dev-latest",
        "symfony/browser-kit": "8.2.*",
        "symfony/phpunit-bridge": "8.2.*",
        "symfony/yaml": "8.2.*"
    },
    "replace": {
        "heidi/core": "self.version",
        "heidi/oidc": "self.version",
        "heidi/symfony-bundle": "self.version"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Heidi\\Core\\": "src/core/src/",
            "Heidi\\Oidc\\": "src/oidc/src/",
            "Heidi\\Bundle\\": "src/symfony/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Heidi\\Core\\Tests\\": "tests/core/",
            "Heidi\\Oidc\\Tests\\": "tests/oidc/",
            "Heidi\\Bundle\\Tests\\": "tests/symfony/",
            "Heidi\\Bundle\\Migrations\\": "src/symfony/migrations/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "infection/extension-installer": true,
            "phpstan/extension-installer": true
        }
    }
}
