# The ignore file of apps/op/Dockerfile. The context of that build is the root of the monorepo (compose.yaml),
# so the paths below are read from that root, and BuildKit reads this file, named after the Dockerfile and
# beside it, in place of a .dockerignore at that root.

# Nothing but what the Dockerfile copies: the packages, where the path repositories of the application
# resolve, and the application.
*
!src/
!apps/op/

# What a working copy holds beside the repository, the paths the .gitignore of the application names: the
# environment "castor provision" writes, with the DSN of the KMS (the key itself under the sodium backend, a
# token under Vault), the secrets of the clients and the password of the development user, and its compiled
# form; the key that decrypts the secrets of production; what Composer, the asset mapper and the suite of the
# application install, build or leave behind. The image compiles its environment from the files the
# repository holds, and installs and builds the rest itself.
apps/op/.env.local
apps/op/.env.local.php
apps/op/.env.*.local
apps/op/config/secrets/prod/prod.decrypt.private.php
apps/op/public/bundles/
apps/op/var/
apps/op/vendor/
apps/op/public/assets/
apps/op/assets/vendor/
apps/op/phpunit.xml
apps/op/.phpunit.cache/

# What the image does not serve: the suite of the application and its environment, and what a repository,
# an editor or a system leaves in a tree.
apps/op/.env.test
apps/op/tests/
apps/op/phpunit.dist.xml
apps/op/config/services_test.yaml
apps/op/config/packages/test/
apps/op/.editorconfig
**/*.log
**/*.md
**/*.php~
**/*.dist.php
**/*.dist
**/*.cache
**/._*
**/*.dockerignore
**/.DS_Store
**/.git/
**/.gitattributes
**/.gitignore
**/.gitmodules
**/compose.*.yaml
**/compose.*.yml
**/compose.yaml
**/compose.yml
**/docker-compose.*.yaml
**/docker-compose.*.yml
**/docker-compose.yaml
**/docker-compose.yml
**/Dockerfile
**/Thumbs.db

# What only the development stack and the lab read, and no deployment serves (issue #922, decision 0030): the
# image carries what a deployment serves. Symfony reads the configuration of an environment in that environment
# alone (config/packages/<env>/, config/routes/<env>/, config/services_<env>.yaml, .env.<env>), and a file whose
# every section is "when@dev" or "when@test" configures nothing for production, so both stay out of the image
# with what they name in the application. TheImageCarriesWhatADeploymentServesTest holds this list to them.
#
# The configuration of development, the debug bundle and the profiler production does not install among it, and
# what a debug kernel writes for an editor to complete the configuration with.
apps/op/.env.dev
apps/op/config/packages/dev/
apps/op/config/packages/debug.yaml
apps/op/config/packages/web_profiler.yaml
apps/op/config/routes/framework.yaml
apps/op/config/routes/web_profiler.yaml
apps/op/config/reference.php
apps/op/config/schema.json
# The demonstration of the flows, read in development and by the suite of the application: its pages, their
# templates and their configuration.
apps/op/src/Demonstration/
apps/op/templates/demonstration/
apps/op/config/packages/demonstration.yaml
apps/op/config/routes/demonstration.yaml
# The lab: what its tasks ask of the application in development (the endpoint "castor mtls" reads, the type of
# authorization detail "castor demo --rar" asks for, and its sentence), the endpoints the conformance tools drive,
# and the metadata of the Entra interoperability that "castor saml-entra" registers.
apps/op/src/Lab/
apps/op/config/packages/lab.yaml
apps/op/config/routes/mtls.yaml
apps/op/config/routes/fido_conformance.yaml
apps/op/config/routes/ciba_conformance.yaml
apps/op/config/beffroi/routes/fido-conformance.php
apps/op/config/beffroi/routes/ciba-conformance.php
apps/op/config/saml/
