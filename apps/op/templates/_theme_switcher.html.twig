{# The choice of a theme (issue #447), a control of this application and of no page of the bundle: the one
   in use under its icon, the three in a list under it, each a button of one form. No script: a details
   element opens on a click and on a keyboard, and submitting reloads the page, which closes it.

   The one in use says so to a screen reader, and each icon carries its name for whoever does not see it. #}
{% set current = theme() %}
{% set icons = {light: 'sun', dark: 'moon', system: 'device'} %}
<details class="dropdown dropdown-end" data-control="theme">
    <summary class="btn btn-ghost btn-sm" aria-label="{{ 'theme.choose'|trans([], 'beffroi') }}">
        {%- include 'layout/icon/' ~ icons[current.value] ~ '.html.twig' -%}
        {%- include 'layout/icon/chevron.html.twig' with {size: 'size-3.5'} -%}
    </summary>
    <form method="post" action="{{ path('app_theme') }}" class="dropdown-content">
        <input type="hidden" name="target" value="{{ app.request.requestUri }}">
        <ul class="menu">
            {% for value, icon in icons %}
                <li>
                    <button type="submit" name="theme" value="{{ value }}"
                            class="{{ current.value == value ? 'menu-active' : '' }}"
                            aria-pressed="{{ current.value == value ? 'true' : 'false' }}">
                        {%- include 'layout/icon/' ~ icon ~ '.html.twig' -%}
                        {{- ('theme.' ~ value)|trans([], 'beffroi') -}}
                    </button>
                </li>
            {% endfor %}
        </ul>
    </form>
</details>
