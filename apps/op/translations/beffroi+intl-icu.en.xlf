<?xml version="1.0" encoding="utf-8"?>
<xliff xmlns="urn:oasis:names:tc:xliff:document:1.2" version="1.2">
  <file source-language="en" target-language="en" datatype="plaintext" original="beffroi">
    <header>
      <note>What this deployment adds to the strings of the bundle, and nothing the bundle already says. One message per type of authorization detail it wires (RFC 9396 §2), named after that type, because the type is a class of the deployment and the sentence a user reads before agreeing to one belongs with it; and the words of what this deployment draws around the pages of the bundle, the theme, the controls of the bar, the headings the pages of the account are arranged under and the line each of them is read by. ICU message format; the parameters of a detail are the ones its type put in the rendering of it.</note>
    </header>
    <body>
      <trans-unit id="a1f0c3e8d2" resname="authorization_details.invoice_payment">
        <source>authorization_details.invoice_payment</source>
        <target>Invoice {identifier}: {actions} it, for at most {amount} {currency}</target>
      </trans-unit>
      <trans-unit id="controls.close" resname="controls.close">
        <source>controls.close</source>
        <target>Close the menus</target>
      </trans-unit>
      <trans-unit id="b7c1d4e9f0" resname="theme.choose">
        <source>theme.choose</source>
        <target>Choose a theme</target>
      </trans-unit>
      <trans-unit id="c3d5e7a1b2" resname="theme.light">
        <source>theme.light</source>
        <target>Light</target>
      </trans-unit>
      <trans-unit id="d9e2f4a6c8" resname="theme.dark">
        <source>theme.dark</source>
        <target>Dark</target>
      </trans-unit>
      <trans-unit id="e1f3a5b7d2" resname="theme.system">
        <source>theme.system</source>
        <target>As the browser asks</target>
      </trans-unit>
      <trans-unit id="f4a6b8c1e3" resname="navigation.pages">
        <source>navigation.pages</source>
        <target>The pages of your account</target>
      </trans-unit>
      <trans-unit id="a8b2c4d6f1" resname="navigation.show_pages">
        <source>navigation.show_pages</source>
        <target>Show the pages of your account</target>
      </trans-unit>
      <trans-unit id="b1c3d5e7a9" resname="navigation.group.record">
        <source>navigation.group.record</source>
        <target>Your record</target>
      </trans-unit>
      <trans-unit id="c2d4e6f8b1" resname="navigation.group.sign_in">
        <source>navigation.group.sign_in</source>
        <target>How you sign in</target>
      </trans-unit>
      <trans-unit id="d3e5f7a9c2" resname="navigation.group.activity">
        <source>navigation.group.activity</source>
        <target>What has happened</target>
      </trans-unit>
      <trans-unit id="e4f6a8b2c1" resname="navigation.where_you_are">
        <source>navigation.where_you_are</source>
        <target>Where you are</target>
      </trans-unit>
      <trans-unit id="navigation.description.approvals" resname="navigation.description.approvals">
        <source>navigation.description.approvals</source>
        <target>Asked in your name, and waiting for your answer.</target>
      </trans-unit>
      <trans-unit id="navigation.description.profile" resname="navigation.description.profile">
        <source>navigation.description.profile</source>
        <target>What this provider holds of you, and what you may correct.</target>
      </trans-unit>
      <trans-unit id="navigation.description.archive" resname="navigation.description.archive">
        <source>navigation.description.archive</source>
        <target>Ask for a copy of all of it, and download it here.</target>
      </trans-unit>
      <trans-unit id="navigation.description.password" resname="navigation.description.password">
        <source>navigation.description.password</source>
        <target>The one you type to sign in, changed here.</target>
      </trans-unit>
      <trans-unit id="navigation.description.passkeys" resname="navigation.description.passkeys">
        <source>navigation.description.passkeys</source>
        <target>Signing in with your device rather than a password.</target>
      </trans-unit>
      <trans-unit id="navigation.description.two_factor" resname="navigation.description.two_factor">
        <source>navigation.description.two_factor</source>
        <target>A second proof after your password, from an authenticator app.</target>
      </trans-unit>
      <trans-unit id="navigation.description.notifications" resname="navigation.description.notifications">
        <source>navigation.description.notifications</source>
        <target>The browsers told when something is waiting for you.</target>
      </trans-unit>
      <trans-unit id="navigation.description.sessions" resname="navigation.description.sessions">
        <source>navigation.description.sessions</source>
        <target>The browsers and the applications holding a session in your name.</target>
      </trans-unit>
      <trans-unit id="navigation.description.consents" resname="navigation.description.consents">
        <source>navigation.description.consents</source>
        <target>What each application obtains of you, and how to take it back.</target>
      </trans-unit>
      <trans-unit id="navigation.description.sign_ins" resname="navigation.description.sign_ins">
        <source>navigation.description.sign_ins</source>
        <target>Who signed in as you, and who tried and did not.</target>
      </trans-unit>
    </body>
  </file>
