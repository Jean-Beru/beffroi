{# The home of the account (architecture §5.2), in the language of the browser: who the browser is signed in
   as and since when, the pages of the account with what the account holds there, and the way out. The pages
   are the sections that are wired, in their order; this template names none of them. This is the bare
   version the suite of the integration renders; the application serves its own (apps/beffroi/templates/beffroi/account/home.html.twig),
   which reads what the kernel of this suite does not boot. #}
{% extends '@Beffroi/layout.html.twig' %}
{% trans_default_domain 'beffroi' %}

{% block title %}{{ 'account.title'|trans }}{% endblock %}

{% block content %}
    <p>{{ 'account.signed_in_as'|trans({username: user.username}) }}</p>
    <p><time datetime="{{ signed_in_since|date('c') }}">{{ 'account.signed_in_since'|trans({date: signed_in_since|beffroi_moment(user)}) }}</time></p>
    <ul data-sections="{{ sections|length }}">
        {% for section in sections %}
            <li data-section="{{ section.route }}">
                <a href="{{ path(section.route) }}">{{ section.title|trans }}</a>
                <span data-state="{{ section.state.key }}">{{ section.state.key|trans(section.state.parameters) }}</span>
            </li>
        {% endfor %}
    </ul>
    <p><a href="{{ path('beffroi_interaction_logout') }}">{{ 'account.sign_out'|trans }}</a></p>
{% endblock %}
