{
    "alias": "beffroi",
    "description": "Beffroi: the OpenID Connect certification plans of the OP (Basic OP, Config OP, Form Post OP, RP-Initiated Logout OP) against the development OP",
    "server": {
        "discoveryUrl": "{BEFFROI_ISSUER}/.well-known/openid-configuration",
        "login_hint": "{BEFFROI_DEV_USERNAME}",
        "ui_locales": "fr"
    },
    "client": {
        "client_id": "conformance-basic",
        "client_secret": "{CONFORMANCE_BASIC_SECRET}"
    },
    "client2": {
        "client_id": "conformance-basic-second",
        "client_secret": "{CONFORMANCE_BASIC_SECOND_SECRET}"
    },
    "client_secret_post": {
        "client_id": "conformance-post",
        "client_secret": "{CONFORMANCE_POST_SECRET}"
    },
    "browser": [
        {
            "comment": "The happy path: sign in when the OP asks, allow when it asks, land on the callback of the suite.",
            "match": "{BEFFROI_ISSUER}/authorize*",
            "tasks": [
                {
                    "task": "Pass the address",
                    "optional": true,
                    "match": "{BEFFROI_ISSUER}/login*",
                    "commands": [
                        [
                            "text",
                            "id",
                            "address",
                            "{BEFFROI_DEV_USERNAME}"
                        ],
                        [
                            "click",
                            "css",
                            "form[data-step=\"address\"] button[type=submit]"
                        ]
                    ]
                },
                {
                    "task": "Sign in",
                    "optional": true,
                    "match": "{BEFFROI_ISSUER}/login*",
                    "commands": [
                        [
                            "text",
                            "id",
                            "username",
                            "{BEFFROI_DEV_USERNAME}"
                        ],
                        [
                            "text",
                            "id",
                            "password",
                            "{BEFFROI_DEV_USER_PASSWORD}"
                        ],
                        [
                            "click",
                            "css",
                            "form[action^=\"/login\"] button[type=submit]"
                        ]
                    ]
                },
                {
                    "task": "Allow",
                    "optional": true,
                    "match": "{BEFFROI_ISSUER}/consent*",
                    "commands": [
                        [
                            "click",
                            "css",
                            "button[name=answer][value=allow]"
                        ]
                    ]
                },
                {
                    "task": "Verify complete",
                    "match": "*/test/a/beffroi/callback*",
                    "commands": [
                        [
                            "wait",
                            "id",
                            "submission_complete",
                            10
                        ]
                    ]
                }
            ]
        },
        {
            "comment": "RP-Initiated Logout: a verified id_token_hint ends the session and sends the browser straight to the post_logout_redirect_uri; without one the OP asks first.",
            "match": "{BEFFROI_ISSUER}/logout*",
            "tasks": [
                {
                    "task": "Confirm",
                    "optional": true,
                    "match": "{BEFFROI_ISSUER}/logout*",
                    "commands": [
                        [
                            "click",
                            "css",
                            "button[name=confirm][value=yes]",
                            "optional"
                        ]
                    ]
                },
                {
                    "task": "Verify complete",
                    "match": "*/test/a/beffroi/post_logout_redirect*"
                }
            ]
        }
    ],
    "override": {
        "fapi2-security-profile-final-ensure-unsigned-authorization-request-without-using-par-fails": {
            "browser": [
                {
                    "comment": "The request cannot be honoured and nothing of it reaches the browser it came from: a request URI already used, expired, or issued to another client (RFC 9126 §2.2), or an authorization request the client did not push although it must (§6). The OP shows its error page; the page fills the screenshot placeholder.",
                    "match": "{BEFFROI_ISSUER}/authorize*",
                    "tasks": [
                        {
                            "task": "Expect the error page",
                            "match": "{BEFFROI_ISSUER}/authorize*",
                            "commands": [
                                [
                                    "wait",
                                    "xpath",
                                    "//*",
                                    10,
                                    "Request refused|Requête refusée",
                                    "update-image-placeholder"
                                ]
                            ]
                        }
                    ]
                }
            ]
        },
        "fapi2-security-profile-final-par-attempt-reuse-request_uri": {
            "browser": [
                {
                    "comment": "RFC 9126 §4: a request_uri is spent once. The first visit signs in and completes on the callback; the second presents the same reference, which the provider has already spent, and it answers with its error page rather than sending anything to a redirect URI it has not read.",
                    "match": "{BEFFROI_ISSUER}/authorize*",
                    "tasks": [
                        {
                            "task": "Pass the address",
                            "optional": true,
                            "match": "{BEFFROI_ISSUER}/login*",
                            "commands": [
                                [
                                    "text",
                                    "id",
                                    "address",
                                    "{BEFFROI_DEV_USERNAME}"
                                ],
                                [
                                    "click",
                                    "css",
                                    "form[data-step=\"address\"] button[type=submit]"
                                ]
                            ]
                        },
                        {
                            "task": "Sign in",
                            "optional": true,
                            "match": "{BEFFROI_ISSUER}/login*",
                            "commands": [
                                [
                                    "wait",
                                    "xpath",
                                    "//*",
                                    10,
                                    "Sign in|Connexion",
                                    "update-image-placeholder-optional"
                                ],
                                [
                                    "text",
                                    "id",
                                    "username",
                                    "{BEFFROI_DEV_USERNAME}"
                                ],
                                [
                                    "text",
                                    "id",
                                    "password",
                                    "{BEFFROI_DEV_USER_PASSWORD}"
                                ],
                                [
                                    "click",
                                    "css",
                                    "form[action^=\"/login\"] button[type=submit]"
                                ]
                            ]
                        },
                        {
                            "task": "Allow",
                            "optional": true,
                            "match": "{BEFFROI_ISSUER}/consent*",
                            "commands": [
                                [
                                    "click",
                                    "css",
                                    "button[name=answer][value=allow]"
                                ]
                            ]
                        },
                        {
                            "task": "Verify complete",
                            "optional": true,
                            "match": "*/test/a/beffroi/callback?*",
                            "commands": [
                                [
                                    "wait",
                                    "id",
                                    "submission_complete",
                                    10
                                ]
                            ]
                        },
                        {
                            "task": "Expect the error page",
                            "optional": true,
                            "match": "{BEFFROI_ISSUER}/authorize*",
                            "commands": [
                                [
                                    "wait",
                                    "xpath",
                                    "//*",
                                    10,
                                    "Request refused|Requête refusée",
                                    "update-image-placeholder-optional"
                                ]
                            ]
                        }
                    ]
                }
            ]
        },
