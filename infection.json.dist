{
    "source": {
        "directories": [
            "src/core/src",
            "src/oidc/src"
        ]
    },
    "timeout": 600,
    "logs": {
        "text": ".ci-tools/infection.txt"
    },
    "mutators": {
        "@default": true,
        "global-ignoreSourceCodeByRegex": [
            "\\$this->logger.*"
        ]
    },
    "phpUnit": {
        "configDir": ".ci-tools"
    }
}
