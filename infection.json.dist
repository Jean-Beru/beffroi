{
    "source": {
        "directories": [
            "src/core/src",
            "src/oidc/src",
            "src/xml-security/src",
            "src/saml2-model/src"
        ]
    },
    "timeout": 600,
    "logs": {
        "text": ".ci-tools/infection.txt"
    },
    "mutators": {
        "@default": true,
        "global-ignoreSourceCodeByRegex": [
            "\\$this->logger.*",
            ".*OPENSSL_VERSION_NUMBER.*"
        ],
        "Throw_": {
            "ignoreSourceCodeByRegex": [
                "throw new SerializationFailed\\('libxml could not serialize the document \\(I-15\\)\\.'\\);",
                "throw new AlgorithmUnavailable\\(.*",
                ".*throw new SigningFailed\\(.*",
                ".*throw new EncryptionFailed\\(.*"
            ]
        }
    },
    "phpUnit": {
        "configDir": ".ci-tools"
    }
}
