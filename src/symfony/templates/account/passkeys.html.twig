{# The passkeys of the signed-in user (architecture §5.2), in the language of the browser: the list with
   the name, the dates and the state of each one, a button that revokes one, and the form that enrols a
   new one, hidden until the script of the bundle finds a browser that can create a passkey. "error" is
   a code of PasskeyEnrolmentController, shown after a failed enrolment. Overridable by an application
   under templates/bundles/BeffroiBundle/. #}
{% extends '@Beffroi/layout.html.twig' %}
{% trans_default_domain 'beffroi' %}

{% block title %}{{ 'passkeys.title'|trans }}{% endblock %}

{% block head %}
    <script src="{{ path('beffroi_interaction_passkey_script') }}" defer></script>
{% endblock %}

{% block content %}
    {{ include('@Beffroi/account/back.html.twig') }}
    <p>{{ 'passkeys.signed_in_as'|trans({username: user.username}) }}</p>
    {% if error is not null %}
        <p data-error="{{ error }}">{{ ('passkeys.error.' ~ error)|trans }}</p>
    {% endif %}
    <table data-passkeys="{{ passkeys|length }}">
        <thead>
            <tr>
                <th>{{ 'passkeys.name'|trans }}</th>
                <th>{{ 'passkeys.created_at'|trans }}</th>
                <th>{{ 'passkeys.last_used_at'|trans }}</th>
                <th>{{ 'passkeys.state'|trans }}</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            {% for passkey in passkeys %}
                <tr data-passkey="{{ passkey.id }}" data-revoked="{{ passkey.revoked ? 'yes' : 'no' }}">
                    <td>{{ passkey.name }}</td>
                    <td><time datetime="{{ passkey.createdAt|date('c') }}">{{ passkey.createdAt|beffroi_moment(user) }}</time></td>
                    <td>{% if passkey.lastUsedAt is not null %}<time datetime="{{ passkey.lastUsedAt|date('c') }}">{{ passkey.lastUsedAt|beffroi_moment(user) }}</time>{% else %}{{ 'passkeys.never_used'|trans }}{% endif %}</td>
                    <td>{% if passkey.revoked %}{{ 'passkeys.revoked_at'|trans({date: passkey.revokedAt|beffroi_moment(user)}) }}{% else %}{{ 'passkeys.active'|trans }}{% endif %}</td>
                    <td>
                        {% if not passkey.revoked %}
                            <form method="post" action="{{ path('beffroi_interaction_account_passkeys_revoke', {id: passkey.id}) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('beffroi_passkey_revoke') }}">
                                <button type="submit" name="revoke" value="{{ passkey.id }}">{{ 'passkeys.revoke'|trans }}</button>
                            </form>
                        {% endif %}
                    </td>
                </tr>
            {% else %}
                {# A table that holds nothing keeps its head and says so in one row of its own, which is
                   how every table of this plane says it. #}
                <tr data-empty><td colspan="5">{{ 'passkeys.none'|trans }}</td></tr>
            {% endfor %}
        </tbody>
    </table>
    {{ include('@Beffroi/account/pager.html.twig', {listing: passkeys}) }}
    <form method="post" action="{{ path('beffroi_interaction_account_passkeys_enrol') }}" data-passkey="enrol" data-options-url="{{ path('beffroi_interaction_account_passkeys_options') }}" hidden>
        <input type="hidden" name="_token" value="{{ csrf_token('beffroi_passkey_enrol') }}">
        <input type="hidden" name="_passkey" value="">
        <label for="passkey-name">{{ 'passkeys.new_name'|trans }}</label>
        <input type="text" id="passkey-name" name="name" maxlength="255" required>
        <button type="button" data-passkey-button>{{ 'passkeys.enrol'|trans }}</button>
        <p data-passkey-error hidden>{{ 'passkeys.error.browser'|trans }}</p>
    </form>
    <p data-passkeys-unsupported>{{ 'passkeys.unsupported'|trans }}</p>
{% endblock %}
