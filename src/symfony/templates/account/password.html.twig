{# The password of the signed-in person (architecture §5.2), in the language of the browser: when it was
   last written, the form that replaces it, and what that form was refused. Nothing visible changes when
   a password does, so the date is what a person reads after they changed it.

   The password in use is typed again because a session is not a proof that whoever holds it knows the
   password; changing it signs every other browser out, which the page says before it is asked for.
   "refusal" is a code of AccountPasswordChangeController or of the refusals of the core.
   Overridable by an application under templates/bundles/BeffroiBundle/. #}
{% extends '@Beffroi/layout.html.twig' %}
{% trans_default_domain 'beffroi' %}

{% block title %}{{ 'password.title'|trans }}{% endblock %}

{% block content %}
    {{ include('@Beffroi/account/back.html.twig') }}
    {% if refusal is not null %}
        <p data-error="{{ refusal }}">{{ ('password.error.' ~ refusal)|trans({minimum: minimum}) }}</p>
    {% endif %}
    {% if password is null %}
        {# Somebody who signs in by another means has nothing to replace here, and posing a first one is
           an enrolment, which proves something first. #}
        <p data-password="none">{{ 'password.none'|trans }}</p>
    {% else %}
        <p data-password="{{ password.id }}"><time datetime="{{ password.hashChangedAt|date('c') }}">{{ 'password.changed_at'|trans({date: password.hashChangedAt|beffroi_moment(user)}) }}</time></p>
        <form method="post" action="{{ path('beffroi_interaction_account_password_change') }}" data-password="change">
            <input type="hidden" name="_token" value="{{ csrf_token('beffroi_password_change') }}">
            <p>{{ 'password.what_happens'|trans }}</p>
            <label for="password-current">{{ 'password.current'|trans }}</label>
            <input type="password" id="password-current" name="current_password" autocomplete="current-password" required>
            <label for="password-new">{{ 'password.new'|trans }}</label>
            <input type="password" id="password-new" name="new_password" minlength="{{ minimum }}" autocomplete="new-password" required>
            <button type="submit">{{ 'password.change'|trans }}</button>
        </form>
    {% endif %}
{% endblock %}
