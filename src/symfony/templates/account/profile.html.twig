{# What this provider holds about the signed-in user (architecture §5.2), in the language of the browser:
   the account itself, which keeping a record for someone keeps, then one line per claim, read where it is
   held and written where the tenant opens it. A record that says nothing of the person says so. What that
   person has changed of it is a page of its own, which this one offers.
   Overridable by an application under templates/bundles/BeffroiBundle/. #}
{% extends '@Beffroi/layout.html.twig' %}
{% trans_default_domain 'beffroi' %}

{% block title %}{{ 'profile.title'|trans }}{% endblock %}

{# What this person has changed of their own record is a page of its own (issue #482), the one thing of
   this record that grows without end, and the way to it is what this page offers. #}
{% block action %}
    <a href="{{ path('beffroi_interaction_account_profile_changes') }}" data-profile="changes">{{ 'changes.title'|trans }}</a>
{% endblock %}

{% block content %}
    {{ include('@Beffroi/account/back.html.twig') }}
    <p>{{ 'profile.explanation'|trans }}</p>
    <h2>{{ 'profile.account'|trans }}</h2>
    <dl data-information="account">
        {% for detail in identity %}
            {{ include('@Beffroi/account/detail.html.twig', {detail: detail}) }}
        {% endfor %}
    </dl>
    {# One line per claim, read where it is held and written where the tenant opens it (issues #452, #476,
       #479): the same claim is not read in one list and offered in another, so that somebody corrects what
       they are reading. A claim this provider holds nothing of and that nobody may fill here is not a line
       at all, a detail nobody gave and nobody may give being nothing to show. #}
    <h2>{{ 'profile.about_you'|trans }}</h2>
    {% if refusal is not null %}<p data-error="{{ refusal }}">{{ ('profile.' ~ refusal)|trans }}</p>{% endif %}
    {% if held == 0 %}<p data-claims="none">{{ 'profile.none'|trans }}</p>{% endif %}
    {% if changeable is empty %}
        <p data-changeable="none">{{ 'profile.change_nothing'|trans }}</p>
    {% else %}
        <p>{{ 'profile.change_explanation'|trans }}</p>
    {% endif %}
    <ul data-information="claims" data-claims="{{ held }}">
        {% for detail in claims %}
            {% set offered = changeable[detail.key] ?? null %}
            {% if offered is not null %}
                {% set field = offered.field %}
                <li data-claim="{{ detail.key }}">
                    <form method="post" action="{{ path('beffroi_interaction_account_profile_describe') }}" data-changeable="{{ detail.key }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('beffroi_profile_describe') }}">
                        <input type="hidden" name="claim" value="{{ detail.key }}">
                        <label for="claim-{{ detail.key }}">{{ ('profile.' ~ detail.key)|trans }}</label>
                        {# What kind of field this is, the claim says (issues #476 and #479): a closed set
                           short enough to read is chosen from a list, one of several hundred is typed into
                           with the whole set suggested, and anything else is typed into an input of the
                           kind the claim named, with what the browser may check before anything is sent. #}
                        {% if field.choices is not empty and not field.isPicked %}
                            <select id="claim-{{ detail.key }}" name="value" data-field="choice">
                                <option value=""{% if offered.held is null %} selected{% endif %}>{{ 'profile.nothing'|trans }}</option>
                                {% for value, label in field.choices %}
                                    <option value="{{ value }}"{% if value == offered.held %} selected{% endif %}>{{ label }}</option>
                                {% endfor %}
                            </select>
                        {% elseif field.choices is not empty %}
                            <input
                                type="text"
                                id="claim-{{ detail.key }}"
                                name="value"
                                value="{{ offered.held }}"
                                data-field="picker"
                                autocomplete="off"
                                list="claim-{{ detail.key }}-values"
                            >
                            <datalist id="claim-{{ detail.key }}-values" data-values="{{ field.choices|length }}">
                                {% for value, label in field.choices %}
                                    <option value="{{ value }}">{{ label }}</option>
                                {% endfor %}
                            </datalist>
                        {% else %}
                            <input
                                type="{{ field.kind }}"
                                id="claim-{{ detail.key }}"
                                name="value"
                                value="{{ offered.held }}"
                                data-field="{{ field.kind }}"
                                autocomplete="off"
                                {%- if field.pattern is not null %} pattern="{{ field.pattern }}"{% endif %}
                                {%- if field.example is not null %} placeholder="{{ field.example|trans }}"{% endif %}
                            >
                        {% endif %}
                        <button type="submit">{{ 'profile.save'|trans }}</button>
                    </form>
                </li>
            {% elseif detail.value is not null or detail.moment is not null %}
                {{ include('@Beffroi/account/claim.html.twig', {detail: detail}) }}
            {% endif %}
        {% endfor %}
    </ul>
{% endblock %}
