{# What this provider holds about the signed-in user (architecture §5.2), in the language of the browser:
   the account itself, which keeping a record for someone keeps, then what that person told us, each thing
   with its label and its value. A record that says nothing of the person says so. Overridable by an
   application under templates/bundles/BeffroiBundle/. #}
{% extends '@Beffroi/layout.html.twig' %}
{% trans_default_domain 'beffroi' %}

{% block title %}{{ 'profile.title'|trans }}{% endblock %}

{% block content %}
    {{ include('@Beffroi/account/back.html.twig') }}
    <p>{{ 'profile.signed_in_as'|trans({username: user.username}) }}</p>
    <p>{{ 'profile.explanation'|trans }}</p>
    <h2>{{ 'profile.account'|trans }}</h2>
    <dl data-information="account">
        {% for detail in identity %}
            {{ include('@Beffroi/account/detail.html.twig', {detail: detail}) }}
        {% endfor %}
    </dl>
    <h2>{{ 'profile.about_you'|trans }}</h2>
    {% if claims is empty %}
        <p data-claims="none">{{ 'profile.none'|trans }}</p>
    {% else %}
        <dl data-information="claims" data-claims="{{ claims|length }}">
            {% for detail in claims %}
                {{ include('@Beffroi/account/detail.html.twig', {detail: detail}) }}
            {% endfor %}
        </dl>
    {% endif %}

    {# What the tenant lets this person change of themselves (issue #452): one field per claim it opens, in
       the order the claims are wired. A tenant that opens none says so, and the list above says what is
       held either way, so what cannot be changed here is read and not offered. #}
    <h2>{{ 'profile.what_you_may_change'|trans }}</h2>
    {% if refusal is not null %}<p data-error="{{ refusal }}">{{ ('profile.' ~ refusal)|trans }}</p>{% endif %}
    {% if changeable is empty %}
        <p data-changeable="none">{{ 'profile.change_nothing'|trans }}</p>
    {% else %}
        <p>{{ 'profile.change_explanation'|trans }}</p>
        {% for claim, offered in changeable %}
            {% set field = offered.field %}
            <form method="post" action="{{ path('beffroi_interaction_account_profile_describe') }}" data-changeable="{{ claim }}">
                <input type="hidden" name="_token" value="{{ csrf_token('beffroi_profile_describe') }}">
                <input type="hidden" name="claim" value="{{ claim }}">
                <label for="claim-{{ claim }}">{{ ('profile.' ~ claim)|trans }}</label>
                {# What kind of field this is, the claim says (issue #476): a closed set is chosen from, and
                   anything else is typed into an input of the kind it named, with what the browser may
                   check before anything is sent. #}
                {% if field.choices is not empty %}
                    <select id="claim-{{ claim }}" name="value" data-field="choice">
                        <option value=""{% if offered.held is null %} selected{% endif %}>{{ 'profile.nothing'|trans }}</option>
                        {% for choice in field.choices %}
                            <option value="{{ choice }}"{% if choice == offered.held %} selected{% endif %}>{{ choice }}</option>
                        {% endfor %}
                    </select>
                {% else %}
                    <input
                        type="{{ field.kind }}"
                        id="claim-{{ claim }}"
                        name="value"
                        value="{{ offered.held }}"
                        data-field="{{ field.kind }}"
                        autocomplete="off"
                        {%- if field.pattern is not null %} pattern="{{ field.pattern }}"{% endif %}
                        {%- if field.example is not null %} placeholder="{{ field.example|trans }}"{% endif %}
                    >
                {% endif %}
                <button type="submit">{{ 'profile.save'|trans }}</button>
            </form>
        {% endfor %}
    {% endif %}
{% endblock %}
