{# The backup codes of an authenticator app just set up (architecture §5.2), shown this once: the page
   is the response to the code that confirmed the enrolment, and the codes are stored hashed, so that
   nothing shows them again. Overridable by an application under templates/bundles/BeffroiBundle/. #}
{% extends '@Beffroi/layout.html.twig' %}
{% trans_default_domain 'beffroi' %}

{% block title %}{{ 'two_factor.enrolled.title'|trans }}{% endblock %}

{% block content %}
    {{ include('@Beffroi/account/back.html.twig') }}
    <p>{{ 'two_factor.signed_in_as'|trans({username: user.username}) }}</p>
    <p data-two-factor="enrolled">{{ 'two_factor.enrolled.done'|trans }}</p>
    <p>{{ 'two_factor.enrolled.codes'|trans }}</p>
    <ul data-two-factor="backup-codes">
        {% for code in backup_codes %}
            <li><code>{{ code }}</code></li>
        {% endfor %}
    </ul>
{% endblock %}
