{# The browsers of the signed-in user this provider may push to (Push API §4, architecture §5.2, §5.6), in
   the language of the browser: the list with what the user called each one and its dates, a button that
   takes one out, and the form that subscribes the browser showing the page, hidden until the script of
   the bundle finds a browser that can hold a subscription and a tenant that hands out a key.
   "application_server_key" is the public half of that key (RFC 8292 §3.2), and null when this deployment
   reaches nobody this way; "error" is a code of PushSubscriptionController.
   Overridable by an application under templates/bundles/BeffroiBundle/. #}
{% extends '@Beffroi/layout.html.twig' %}
{% trans_default_domain 'beffroi' %}

{% block title %}{{ 'notifications.title'|trans }}{% endblock %}

{% block head %}
    <script src="{{ path('beffroi_interaction_push_script') }}" defer></script>
{% endblock %}

{% block content %}
    {{ include('@Beffroi/account/back.html.twig') }}
    <p>{{ 'notifications.signed_in_as'|trans({username: user.username}) }}</p>
    <p>{{ 'notifications.what_is_sent'|trans }}</p>
    {% if error is not null %}
        <p data-error="{{ error }}">{{ ('notifications.error.' ~ error)|trans }}</p>
    {% endif %}
    {% if subscriptions is empty %}
        <p data-subscriptions="none">{{ 'notifications.none'|trans }}</p>
    {% else %}
        <table data-subscriptions="{{ subscriptions|length }}">
            <thead>
                <tr>
                    <th>{{ 'notifications.label'|trans }}</th>
                    <th>{{ 'notifications.created_at'|trans }}</th>
                    <th>{{ 'notifications.last_pushed_at'|trans }}</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                {% for subscription in subscriptions %}
                    <tr data-subscription="{{ subscription.id }}">
                        <td>{{ subscription.label ?? 'notifications.unnamed'|trans }}</td>
                        <td><time datetime="{{ subscription.createdAt|date('c') }}">{{ subscription.createdAt|date('Y-m-d H:i') }}</time></td>
                        <td>{% if subscription.lastPushedAt is not null %}<time datetime="{{ subscription.lastPushedAt|date('c') }}">{{ subscription.lastPushedAt|date('Y-m-d H:i') }}</time>{% else %}{{ 'notifications.never_pushed'|trans }}{% endif %}</td>
                        <td>
                            <form method="post" action="{{ path('beffroi_interaction_account_notifications_revoke', {id: subscription.id}) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('beffroi_push_revoke') }}">
                                <button type="submit" name="revoke" value="{{ subscription.id }}">{{ 'notifications.revoke'|trans }}</button>
                            </form>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% endif %}
    <form method="post" action="{{ path('beffroi_interaction_account_notifications_subscribe') }}" data-push="subscribe" data-application-server-key="{{ application_server_key ?? '' }}" data-worker-url="{{ path('beffroi_interaction_push_worker') }}" hidden>
        <input type="hidden" name="_token" value="{{ csrf_token('beffroi_push_subscribe') }}">
        <input type="hidden" name="endpoint" value="">
        <input type="hidden" name="p256dh" value="">
        <input type="hidden" name="auth" value="">
        <label for="push-label">{{ 'notifications.new_label'|trans }}</label>
        <input type="text" id="push-label" name="label" maxlength="255">
        <button type="button" data-push-button>{{ 'notifications.subscribe'|trans }}</button>
        <p data-push-error hidden>{{ 'notifications.error.browser'|trans }}</p>
    </form>
    <p data-push-unsupported {% if application_server_key is not null %}hidden{% endif %}>{{ application_server_key is null ? 'notifications.not_served'|trans : 'notifications.unsupported'|trans }}</p>
{% endblock %}
