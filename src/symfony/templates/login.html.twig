{# The login page, in the locale the interaction recorded. It serves the interaction that is waiting for a
   login and, with no client to name, the page of the provider that asked for one and is not an
   authorization request (the page where a user approves what an appliance asked, RFC 8628 §3.3). The form is the one the form
   login of the firewall reads (architecture §5.4); a refused login shows one message, whatever the reason.
   Below it, the passkey: hidden until the script of the bundle finds a browser that can hold one, then
   a button, and the autofill of the username field when the browser offers it (conditional UI); the
   signed assertion is posted as a form to the passkey authenticator of the same firewall. On a step-up
   (decision 0010) the page names the classes the client accepts and says which of the credentials the
   user holds would satisfy one, by kind (login.step_up.<kind>: a passkey, the password, a TOTP after the
   password), nothing of a kind they do not hold; both forms stay offered. A step-up asked for by a page
   of the provider names no client, that page serving no request of a browser (CIBA Core §7.1).
   Overridable by an application under templates/bundles/BeffroiBundle/. #}
{% extends '@Beffroi/layout.html.twig' %}
{% trans_default_domain 'beffroi' %}

{% block title %}{{ 'login.title'|trans }}{% endblock %}

{% block head %}
    <script src="{{ path('beffroi_interaction_passkey_script') }}" defer></script>
{% endblock %}

{% block content %}
    <p>{{ client is null ? 'login.prompt_alone'|trans : 'login.prompt'|trans({client: client.registration.presentation.name}) }}</p>
    {% if step_up is not null %}
        <p data-requirement="{{ requirement.value }}" data-acr="{{ step_up.classes|join(' ') }}">{{ client is null ? 'login.step_up_alone'|trans : 'login.step_up'|trans({client: client.registration.presentation.name}) }}</p>
        {% for kind in step_up.kinds %}
            <p data-step-up="{{ kind }}">{{ ('login.step_up.' ~ kind)|trans }}</p>
        {% endfor %}
    {% elseif requirement is not null and requirement.value != 'no_session' %}
        <p data-requirement="{{ requirement.value }}">{{ 'login.reauthentication'|trans }}</p>
    {% endif %}
    {% if failed %}
        <p data-error="authentication_failed">{{ 'login.failed'|trans }}</p>
    {% endif %}
    <form method="post" action="{{ path('beffroi_interaction_login', interaction is null ? {} : {interaction: interaction.id}) }}">
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
        <label for="username">{{ 'login.username'|trans }}</label>
        <input type="text" id="username" name="_username" value="{{ username ?? '' }}" autocomplete="username webauthn" required autofocus>
        <label for="password">{{ 'login.password'|trans }}</label>
        <input type="password" id="password" name="_password" autocomplete="current-password" required>
        <button type="submit">{{ 'login.submit'|trans }}</button>
    </form>
    <form method="post" action="{{ path('beffroi_interaction_passkey_login', interaction is null ? {} : {interaction: interaction.id}) }}" data-passkey="login" data-options-url="{{ path('beffroi_interaction_passkey_login_options', interaction is null ? {} : {interaction: interaction.id}) }}" hidden>
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
        <input type="hidden" name="_passkey" value="">
        <button type="button" data-passkey-button>{{ 'login.passkey'|trans }}</button>
        <p data-passkey-error hidden>{{ 'login.passkey_failed'|trans }}</p>
    </form>
{% endblock %}
