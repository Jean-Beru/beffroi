{#
    The panel of the provider (issue #152). It renders observations it has never heard of: an observer
    says what its heading is and which facts go under it, and nothing here enumerates them.
#}
{% extends '@WebProfiler/Profiler/layout.html.twig' %}

{% block toolbar %}
    {% if collector.observations is not empty %}
        {% set icon %}
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="3" y="11" width="18" height="10" rx="2"></rect>
                <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
            </svg>
            <span class="sf-toolbar-value">{{ collector.observations|length }}</span>
        {% endset %}

        {% set text %}
            {% for observation in collector.observations %}
                <div class="sf-toolbar-info-piece">
                    <b>{{ observation.heading }}</b>
                    <span>{{ observation.entries|first|default('') }}</span>
                </div>
            {% endfor %}
        {% endset %}

        {{ include('@WebProfiler/Profiler/toolbar_item.html.twig', { link: true }) }}
    {% endif %}
{% endblock %}

{% block menu %}
    <span class="label {{ collector.observations is empty ? 'disabled' }}">
        <span class="icon">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="3" y="11" width="18" height="10" rx="2"></rect>
                <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
            </svg>
        </span>
        <strong>OpenID Provider</strong>
    </span>
{% endblock %}

{% block panel %}
    <h2>What the provider received, decided and emitted</h2>

    {% if collector.observations is empty %}
        <div class="empty">
            <p>This request reached no endpoint of the provider.</p>
        </div>
    {% else %}
        <p class="help">
            No token, secret, proof or key material is collected here. What is personal data is named rather than given.
        </p>

        {% for observation in collector.observations %}
            <h3>{{ observation.heading }}</h3>
            <table>
                <thead>
                    <tr>
                        <th scope="col" class="key">Fact</th>
                        <th scope="col">Value</th>
                    </tr>
                </thead>
                <tbody>
                    {% for label, value in observation.entries %}
                        <tr>
                            <th scope="row">{{ label }}</th>
                            <td>{{ value|nl2br }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% endfor %}
    {% endif %}
{% endblock %}
