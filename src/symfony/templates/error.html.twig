{# The page shown when a request cannot go on and nothing may be sent to a client (RFC 9700 §4.1,
   RP-Initiated Logout §4), in the locale of the request. "error" is a code: the "error" of the protocol,
   or one of the constants of AuthorizationResponder and of the controllers; the codes this page can
   explain get their sentence, any other the general one. "description", when there is one, is the
   error_description of the protocol: what the developer of the application needs to fix their request
   (RFC 6749 §4.1.2.1), in the language of the specification. Overridable by an application under
   templates/bundles/HeidiBundle/. #}
{% extends '@Heidi/layout.html.twig' %}
{% trans_default_domain 'heidi' %}

{% set explained_errors = ['unknown_interaction', 'interaction_expired', 'interaction_completed', 'invalid_csrf_token', 'invalid_request', 'login_required', 'no_login_to_begin', 'too_many_requests'] %}

{% block title %}{{ 'error.title'|trans }}{% endblock %}

{% block content %}
    <p data-error="{{ error }}">{{ (error in explained_errors ? 'error.' ~ error : 'error.default')|trans }}</p>
    {% if description is not null %}
        <p data-description><code>{{ error }}</code>: {{ description }}</p>
    {% endif %}
{% endblock %}
