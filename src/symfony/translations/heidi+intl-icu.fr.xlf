  <file source-language="en" target-language="fr" datatype="plaintext" original="heidi">
    <header>
      <note>The pages of the interaction plane (architecture §5.7): every string a user reads. ICU message format: {client} is the name of the client, {username} the name of the user.</note>
    </header>
    <body>
      <trans-unit id="b3bb2f3a07" resname="login.title">
        <source>login.title</source>
        <target>Connexion</target>
      </trans-unit>
      <trans-unit id="456091ca2c" resname="login.prompt">
        <source>login.prompt</source>
        <target>{client} vous demande de vous connecter.</target>
      </trans-unit>
      <trans-unit id="80fbd248a3" resname="login.reauthentication">
        <source>login.reauthentication</source>
        <target>Veuillez vous reconnecter pour continuer.</target>
      </trans-unit>
      <trans-unit id="55b0f4b87b" resname="login.failed">
        <source>login.failed</source>
        <target>La connexion a échoué. Vérifiez votre nom d’utilisateur et votre mot de passe, puis réessayez.</target>
      </trans-unit>
      <trans-unit id="04690da6d3" resname="login.username">
        <source>login.username</source>
        <target>Nom d’utilisateur</target>
      </trans-unit>
      <trans-unit id="f65ca78fed" resname="login.password">
        <source>login.password</source>
        <target>Mot de passe</target>
      </trans-unit>
      <trans-unit id="4fea9c0c55" resname="login.submit">
        <source>login.submit</source>
        <target>Se connecter</target>
      </trans-unit>
      <trans-unit id="27c34297f7" resname="consent.title">
        <source>consent.title</source>
        <target>Autoriser {client}</target>
      </trans-unit>
      <trans-unit id="db56775db9" resname="consent.signed_in_as">
        <source>consent.signed_in_as</source>
        <target>Session ouverte pour {username}.</target>
      </trans-unit>
      <trans-unit id="55eb317d06" resname="consent.request">
        <source>consent.request</source>
        <target>{client} demande l’accès à :</target>
      </trans-unit>
      <trans-unit id="271b1bd84f" resname="consent.allow">
        <source>consent.allow</source>
        <target>Autoriser</target>
      </trans-unit>
      <trans-unit id="f2fab12b37" resname="consent.deny">
        <source>consent.deny</source>
        <target>Refuser</target>
      </trans-unit>
      <trans-unit id="bbb000871f" resname="scope.openid">
        <source>scope.openid</source>
        <target>Qui vous êtes : votre identifiant chez ce fournisseur</target>
      </trans-unit>
      <trans-unit id="2e384f832b" resname="scope.profile">
        <source>scope.profile</source>
        <target>Votre profil : nom, photo, langue</target>
      </trans-unit>
      <trans-unit id="c5ee1b4219" resname="scope.email">
        <source>scope.email</source>
        <target>Votre adresse e-mail</target>
      </trans-unit>
      <trans-unit id="d7c77b8f51" resname="scope.address">
        <source>scope.address</source>
        <target>Votre adresse postale</target>
      </trans-unit>
      <trans-unit id="ef5674b605" resname="scope.phone">
        <source>scope.phone</source>
        <target>Votre numéro de téléphone</target>
      </trans-unit>
      <trans-unit id="33607b30f0" resname="scope.offline_access">
        <source>scope.offline_access</source>
        <target>Un accès en votre absence, jusqu’à ce que vous le révoquiez</target>
      </trans-unit>
      <trans-unit id="aac9493a9a" resname="logout.title">
        <source>logout.title</source>
        <target>Déconnexion</target>
      </trans-unit>
      <trans-unit id="b62f1870d8" resname="logout.prompt.client">
        <source>logout.prompt.client</source>
        <target>{client} demande à vous déconnecter.</target>
      </trans-unit>
      <trans-unit id="5c9a3f6527" resname="logout.prompt.anonymous">
