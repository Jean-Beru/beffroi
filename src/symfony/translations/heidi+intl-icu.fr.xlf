        <target>Vous pouvez fermer cette fenêtre.</target>
      </trans-unit>
      <trans-unit id="dc96b2d115" resname="still_signed_in.title">
        <source>still_signed_in.title</source>
        <target>Session toujours ouverte</target>
      </trans-unit>
      <trans-unit id="66be09af33" resname="still_signed_in.unchanged">
        <source>still_signed_in.unchanged</source>
        <target>Rien n’a été modifié.</target>
      </trans-unit>
      <trans-unit id="49a8c3fb96" resname="error.title">
        <source>error.title</source>
        <target>Requête refusée</target>
      </trans-unit>
      <trans-unit id="3d21b51c86" resname="error.default">
        <source>error.default</source>
        <target>Ce fournisseur ne peut pas servir la requête. Recommencez depuis l’application.</target>
      </trans-unit>
      <trans-unit id="607d0dc2ff" resname="error.unknown_interaction">
        <source>error.unknown_interaction</source>
        <target>Aucune requête n’attend cette page. Recommencez depuis l’application.</target>
      </trans-unit>
      <trans-unit id="feaea8469d" resname="error.interaction_expired">
        <source>error.interaction_expired</source>
        <target>La requête a pris trop de temps. Recommencez depuis l’application.</target>
      </trans-unit>
      <trans-unit id="35d471521d" resname="error.interaction_completed">
        <source>error.interaction_completed</source>
        <target>La requête a déjà reçu sa réponse. Recommencez depuis l’application.</target>
      </trans-unit>
      <trans-unit id="7a2863564f" resname="error.invalid_csrf_token">
        <source>error.invalid_csrf_token</source>
        <target>Le formulaire n’a pas été envoyé depuis ce fournisseur. Recommencez depuis l’application.</target>
      </trans-unit>
      <trans-unit id="9b1e13b67f" resname="error.invalid_request">
        <source>error.invalid_request</source>
        <target>L’application a envoyé une requête que ce fournisseur ne peut pas servir. Recommencez depuis l’application.</target>
      </trans-unit>
    </body>
