        <target>Votre déconnexion est demandée.</target>
      </trans-unit>
      <trans-unit id="beb2b22fa9" resname="logout.signed_in_as">
        <source>logout.signed_in_as</source>
        <target>Session ouverte pour {username}. Voulez-vous vous déconnecter ?</target>
      </trans-unit>
      <trans-unit id="e6a1f46cff" resname="logout.confirm">
        <source>logout.confirm</source>
        <target>Se déconnecter</target>
      </trans-unit>
      <trans-unit id="879d52571c" resname="logout.stay">
