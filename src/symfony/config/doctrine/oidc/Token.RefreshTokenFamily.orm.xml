<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                                      https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <!-- The lineage of refresh tokens descending from one code (architecture §4.6), carried by each of its tokens. -->
    <embeddable name="Heidi\Oidc\Domain\Token\RefreshTokenFamily">
        <field name="id" type="uuid" column="id"/>
        <field name="grantingRecordHash" type="string" column="granting_record_hash" length="64">
            <options>
                <option name="fixed">true</option>
            </options>
        </field>
        <field name="grantId" type="uuid" column="grant_id"/>
        <field name="startedAt" type="datetime_immutable" column="started_at"/>
        <field name="expiresAt" type="datetime_immutable" column="expires_at"/>
    </embeddable>
</doctrine-mapping>
