<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                                      https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <!-- What the provider keeps of a device authorization request (RFC 8628 §3.2): the two codes by their hash, the one the client polls with as the key and the one the user types under a unique constraint, because the page that takes a code looks it up by itself. Where the appliance asked from is kept because the approval page shows it (BCP 10027 §2). The session the user approved with, and what it had proven then, arrive when somebody answers and are null until then, which is why the snapshot is a document here and an embeddable where it is there from the start. The client is a registration the module reads from its repository, not a row, as it is for a pushed request. -->
    <entity name="Heidi\Oidc\Domain\Device\DeviceAuthorizationRecord" table="heidi_device_authorization_request">
        <indexes>
            <index name="heidi_device_authorization_expiry" columns="expires_at"/>
        </indexes>
        <unique-constraints>
            <unique-constraint name="heidi_device_authorization_user_code" columns="user_code_hash"/>
        </unique-constraints>
        <id name="deviceCodeHash" type="string" column="device_code_hash" length="64">
            <options>
                <option name="fixed">true</option>
            </options>
        </id>
        <field name="userCodeHash" type="string" column="user_code_hash" length="64">
            <options>
                <option name="fixed">true</option>
            </options>
        </field>
        <many-to-one field="tenant" target-entity="Heidi\Core\Domain\Tenant\Tenant">
            <join-column name="tenant_id" referenced-column-name="id" nullable="false"/>
        </many-to-one>
        <field name="clientId" type="string" column="client_id" length="255"/>
        <field name="scopes" type="heidi_scopes" column="scopes"/>
        <field name="resources" type="heidi_resources" column="resources" nullable="true"/>
        <embedded name="requestedFrom" class="Heidi\Core\Domain\Session\RequestContext" column-prefix="requested_from_"/>
        <field name="issuedAt" type="datetime_immutable" column="issued_at"/>
        <field name="expiresAt" type="datetime_immutable" column="expires_at"/>
        <field name="interval" type="integer" column="poll_interval"/>
        <field name="lastPolledAt" type="datetime_immutable" column="last_polled_at" nullable="true"/>
        <field name="approvedAt" type="datetime_immutable" column="approved_at" nullable="true"/>
        <field name="deniedAt" type="datetime_immutable" column="denied_at" nullable="true"/>
        <many-to-one field="session" target-entity="Heidi\Core\Domain\Session\AuthenticationSession">
            <join-column name="session_id" referenced-column-name="id" nullable="true" on-delete="CASCADE"/>
        </many-to-one>
        <field name="authentication" type="heidi_authentication_snapshot" column="authentication" nullable="true">
            <options>
                <option name="jsonb">true</option>
            </options>
        </field>
        <entity-listeners>
            <entity-listener class="Heidi\Bundle\Doctrine\Listener\ClientResolver">
                <lifecycle-callback type="postLoad" method="postLoad"/>
            </entity-listener>
        </entity-listeners>
    </entity>
</doctrine-mapping>
