<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                                      https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <!-- One issuer (architecture §3.1). Every other table carries its identifier. -->
    <entity name="Heidi\Core\Domain\Tenant\Tenant" table="heidi_tenant">
        <unique-constraints>
            <unique-constraint name="heidi_tenant_slug" columns="slug"/>
            <unique-constraint name="heidi_tenant_issuer" columns="issuer"/>
        </unique-constraints>
        <id name="id" type="uuid" column="id"/>
        <field name="slug" type="string" column="slug" length="63"/>
        <field name="issuer" type="heidi_issuer" column="issuer" length="255"/>
        <field name="name" type="string" column="name" length="255"/>
        <field name="createdAt" type="datetime_immutable" column="created_at"/>
    </entity>
</doctrine-mapping>
