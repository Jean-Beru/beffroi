<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                                      https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <!-- Who is authenticated, since when, how and from where (architecture §3.2, §3.5): the proofs as one document, the provenance of the first and of the last request as columns. -->
    <entity name="Heidi\Core\Domain\Session\AuthenticationSession" table="heidi_authentication_session">
        <id name="id" type="uuid" column="id"/>
        <many-to-one field="tenant" target-entity="Heidi\Core\Domain\Tenant\Tenant">
            <join-column name="tenant_id" referenced-column-name="id" nullable="false"/>
        </many-to-one>
        <many-to-one field="user" target-entity="Heidi\Core\Domain\Identity\User">
            <join-column name="user_id" referenced-column-name="id" nullable="false" on-delete="CASCADE"/>
        </many-to-one>
        <field name="establishedAt" type="datetime_immutable" column="established_at"/>
        <field name="proofs" type="heidi_authentication_proofs" column="proofs">
            <options>
                <option name="jsonb">true</option>
            </options>
        </field>
        <embedded name="createdFrom" class="Heidi\Core\Domain\Session\RequestContext" column-prefix="created_from_"/>
        <embedded name="lastSeenFrom" class="Heidi\Core\Domain\Session\RequestContext" column-prefix="last_seen_from_"/>
        <field name="lastSeenAt" type="datetime_immutable" column="last_seen_at"/>
        <field name="expiresAt" type="datetime_immutable" column="expires_at"/>
        <field name="endedAt" type="datetime_immutable" column="ended_at" nullable="true"/>
        <field name="endedBy" type="string" column="ended_by" length="32" nullable="true" enum-type="Heidi\Core\Domain\Session\SessionEnd"/>
    </entity>
</doctrine-mapping>
