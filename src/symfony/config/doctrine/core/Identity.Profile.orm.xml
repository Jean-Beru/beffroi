<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                                      https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <!-- The standard profile of OIDC Core §5.1, one column per claim on the user. -->
    <embeddable name="Heidi\Core\Domain\Identity\Profile">
        <field name="name" type="string" column="name" length="255" nullable="true"/>
        <field name="givenName" type="string" column="given_name" length="255" nullable="true"/>
        <field name="familyName" type="string" column="family_name" length="255" nullable="true"/>
        <field name="middleName" type="string" column="middle_name" length="255" nullable="true"/>
        <field name="nickname" type="string" column="nickname" length="255" nullable="true"/>
        <field name="preferredUsername" type="string" column="preferred_username" length="255" nullable="true"/>
        <field name="profileUrl" type="text" column="profile_url" nullable="true"/>
        <field name="pictureUrl" type="text" column="picture_url" nullable="true"/>
        <field name="websiteUrl" type="text" column="website_url" nullable="true"/>
        <field name="gender" type="string" column="gender" length="64" nullable="true"/>
        <field name="birthdate" type="string" column="birthdate" length="10" nullable="true"/>
        <field name="zoneinfo" type="string" column="zoneinfo" length="64" nullable="true"/>
        <field name="locale" type="string" column="locale" length="35" nullable="true"/>
    </embeddable>
</doctrine-mapping>
