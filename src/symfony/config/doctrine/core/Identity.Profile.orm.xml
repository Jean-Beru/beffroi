<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                                      https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <!--
      The standard profile of OIDC Core §5.1, one column per claim on the user, every one of them sealed
      under the data key of its tenant in the "user" family (decisions 0011 and 0018). The "length" each
      one carries is the length the domain checks; a sealed column is unbounded binary.

      None of them carries a blind index, and four of them must never carry one: a tag says which rows
      share a value, so on "gender", "locale", "zoneinfo" and "birthdate", which hold few distinct values
      whose distribution is known, counting the tags recovers the values themselves. Decision 0011 refuses
      it in as many words. What is searched by equality here is nothing: the console looks a user up by its
      identifier, its username or its address (BlindIndexedColumns).
    -->
    <embeddable name="Beffroi\Core\Domain\Identity\Profile">
        <field name="name" type="beffroi_encrypted_user_string" column="name" length="255" nullable="true"/>
        <field name="givenName" type="beffroi_encrypted_user_string" column="given_name" length="255" nullable="true"/>
        <field name="familyName" type="beffroi_encrypted_user_string" column="family_name" length="255" nullable="true"/>
        <field name="middleName" type="beffroi_encrypted_user_string" column="middle_name" length="255" nullable="true"/>
        <field name="nickname" type="beffroi_encrypted_user_string" column="nickname" length="255" nullable="true"/>
        <field name="preferredUsername" type="beffroi_encrypted_user_string" column="preferred_username" length="255" nullable="true"/>
        <field name="profileUrl" type="beffroi_encrypted_user_text" column="profile_url" nullable="true"/>
        <field name="pictureUrl" type="beffroi_encrypted_user_text" column="picture_url" nullable="true"/>
        <field name="websiteUrl" type="beffroi_encrypted_user_text" column="website_url" nullable="true"/>
        <field name="gender" type="beffroi_encrypted_user_string" column="gender" length="64" nullable="true"/>
        <field name="birthdate" type="beffroi_encrypted_user_string" column="birthdate" length="10" nullable="true"/>
        <field name="zoneinfo" type="beffroi_encrypted_user_string" column="zoneinfo" length="64" nullable="true"/>
        <field name="locale" type="beffroi_encrypted_user_string" column="locale" length="35" nullable="true"/>
    </embeddable>
</doctrine-mapping>
