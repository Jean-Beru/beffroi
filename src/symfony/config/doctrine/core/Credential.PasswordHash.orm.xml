<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                                      https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <!-- A password hash names its algorithm; the encoded form and the parameters an import keeps apart from the digest. -->
    <embeddable name="Beffroi\Core\Domain\Credential\PasswordHash">
        <field name="algorithm" type="beffroi_password_algorithm" column="algorithm" length="32"/>
        <field name="encoded" type="text" column="encoded"/>
        <field name="parameters" type="json" column="parameters">
            <options>
                <option name="jsonb">true</option>
            </options>
        </field>
    </embeddable>
</doctrine-mapping>
