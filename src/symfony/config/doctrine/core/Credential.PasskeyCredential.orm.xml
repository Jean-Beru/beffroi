<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                                      https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <!-- A passkey of a user, several per user: the credential record of WebAuthn Level 3 §6.1.4 with its name and its revocation; the row stays once revoked. The credential ID is unique in the tenant (§7.1, step 26), the user handle is looked up by the authentication ceremony. -->
    <entity name="Heidi\Core\Domain\Credential\PasskeyCredential" table="heidi_passkey_credential">
        <unique-constraints>
            <unique-constraint name="heidi_passkey_credential_id" columns="tenant_id,credential_id"/>
        </unique-constraints>
        <indexes>
            <index name="heidi_passkey_credential_user_handle" columns="tenant_id,user_handle"/>
        </indexes>
        <field name="name" type="string" column="name" length="255"/>
        <!-- externalId: the credential ID, under the name every kind presented by an identifier maps (ExternallyIdentifiedCredentialInterface), so that the repository names no kind -->
        <field name="externalId" type="heidi_bytes" column="credential_id"/>
        <field name="publicKey" type="heidi_bytes" column="public_key"/>
        <field name="signCount" type="bigint" column="sign_count"/>
        <field name="transports" type="json" column="transports">
            <options>
                <option name="jsonb">true</option>
            </options>
        </field>
        <field name="backupEligible" type="boolean" column="backup_eligible"/>
        <field name="backedUp" type="boolean" column="backed_up"/>
        <field name="aaguid" type="uuid" column="aaguid"/>
        <field name="userHandle" type="heidi_passkey_user_handle" column="user_handle" length="86"/>
        <field name="revokedAt" type="datetime_immutable" column="revoked_at" nullable="true"/>
    </entity>
</doctrine-mapping>
